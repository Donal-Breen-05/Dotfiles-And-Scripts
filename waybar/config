{
    "layer": "top",
    "position": "top",
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,

    "modules-left": [
        "sway/workspaces",
        "custom/playerctl"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/notifications",
        "tray",
        "pulseaudio",
        "backlight",
        "battery"
    ],
    "sway/workspaces": {
      "disable-scroll": true,
      "all-outputs": false,
      "format": "{name}",
      "sort-by-number": true,
      "persistent-workspaces": {
          "eDP-1": [1, 2, 3, 4, 5, 6]
      }
  },

    "clock": {
        "format": "󰥔  {:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "custom/playerctl": {
        "exec": "~/.config/waybar/scripts/playerctl.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },

    "custom/notifications": {
        "exec": "~/.config/waybar/scripts/notif.sh",
        "interval": 2,
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ]
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "states": {
            "warning": 30,
            "critical": 15
        }
    }
}
